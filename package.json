{
  "name": "cmld-keyboard-trainer",
  "version": "1.1.0",
  "description": "CMLD Keyboard Trainer - Cape Maclear Learning and Development",
  "author": "Cape Maclear Learning and Development",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.cmld.keyboardtrainer",
